diff --git a/web/src/components/admin/AdminStatusFilter.tsx b/web/src/components/admin/AdminStatusFilter.tsx
new file mode 100644
index 0000000..9a52354
--- /dev/null
+++ b/web/src/components/admin/AdminStatusFilter.tsx
@@ -0,0 +1,16 @@
+"use client"
+import { useId } from "react"
+import { ADMIN_CONTENT_STATUSES, ADMIN_STATUSES, normalizeAdminStatuses, type AdminContentStatus } from "@/lib/admin-posts"
+export default function AdminStatusFilter({label, value, onChange, error}: {
+  label: string; value: readonly AdminContentStatus[]; onChange: (value: AdminContentStatus[]) => void; error: string
+}) {
+  const id = useId()
+  return <fieldset className="admin-status-filter" aria-describedby={error ? `${id}-error` : undefined} aria-invalid={!!error}>
+    <legend>{label}</legend>
+    <div className="admin-status-options">{ADMIN_CONTENT_STATUSES.map(status => <label key={status} htmlFor={`${id}-${status}`}>
+      <input id={`${id}-${status}`} type="checkbox" checked={value.includes(status)} onChange={event => onChange(normalizeAdminStatuses(event.target.checked ? [...value,status] : value.filter(v => v !== status)))}/>
+      {ADMIN_STATUSES[status]}
+    </label>)}</div>
+    {error && <p id={`${id}-error`} role="alert">{error}</p>}
+  </fieldset>
+}
